<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/rest_panel" android:background="@drawable/notification_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
 <TextView android:id="@+id/rest_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="나를 위한 잠깐의 휴식 ♡" android:textSize="14sp" android:textStyle="bold" android:textColor="#F2F8EC" />
 <Chronometer android:id="@+id/rest_clock" android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:textSize="42sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#C8FA71" />
 <TextView android:id="@+id/rest_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="남은 시간 · 끝나면 소리와 진동으로 알려드려요" android:textSize="12sp" android:textColor="#BDD0B4" />
</LinearLayout>

