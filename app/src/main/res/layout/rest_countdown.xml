<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/rest_panel" android:background="@drawable/notification_panel" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp">
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
  <TextView android:id="@+id/rest_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="휴식 중 ♡" android:textSize="14sp" android:textStyle="bold" android:textColor="#F2F8EC" />
  <TextView android:id="@+id/rest_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="다음 세트까지" android:textSize="11sp" android:textColor="#BDD0B4" />
 </LinearLayout>
 <Chronometer android:id="@+id/rest_clock" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#C8FA71" />
</LinearLayout>

