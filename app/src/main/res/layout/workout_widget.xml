<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_bg">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIFTLOG  /  리프트로그" android:textColor="#AD2E68" android:textSize="12sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="이번 주 0회 ♡" android:textColor="#632F4B" android:textSize="24sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_last" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="첫 운동을 기록해 보세요" android:textColor="#856878" android:textSize="12sp" android:maxLines="2"/>
 <TextView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:background="@drawable/widget_button" android:text="＋ 운동 시작" android:textStyle="bold" android:textSize="14sp" android:textColor="#FFFFFF"/>
</LinearLayout>
